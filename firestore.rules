rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone signed in (anonymously) who knows a 6-char group code can read
    // that group; each person can only write their own location.
    match /groups/{code} {
      allow get: if request.auth != null;
      allow list: if false;               // codes cannot be enumerated
      allow create: if request.auth != null;
      match /members/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
