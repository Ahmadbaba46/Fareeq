rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // One small profile photo per person.
    match /avatars/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && file == request.auth.uid + '.jpg'
        && request.resource.size < 200 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow delete: if request.auth != null && file == request.auth.uid + '.jpg';
    }
  }
}
